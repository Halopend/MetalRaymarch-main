<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Threshold</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Threshold Fractal Scene</string>
			<key>CFBundleTypeIconFile</key>
			<string>ThresholdDocumentIcon.icns</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.puppypower.threshold.scene</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Threshold Music Preset</string>
			<key>CFBundleTypeIconFile</key>
			<string>ThresholdDocumentIcon.icns</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.puppypower.threshold.music-preset</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Threshold Animation</string>
			<key>CFBundleTypeIconFile</key>
			<string>ThresholdDocumentIcon.icns</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.puppypower.threshold.animation</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Threshold Music Video Animation</string>
			<key>CFBundleTypeIconFile</key>
			<string>ThresholdDocumentIcon.icns</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.puppypower.threshold.music-animation</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Threshold Custom Formula</string>
			<key>CFBundleTypeIconFile</key>
			<string>ThresholdDocumentIcon.icns</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.puppypower.threshold.formula</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Threshold</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>shareddocuments</string>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSAppleMusicUsageDescription</key>
	<string>Threshold uses Apple Music to let you browse your library, select songs and playlists, and drive audio-reactive visuals.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Threshold uses the microphone for real-time audio-reactive fractal visualization.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Automatic/sudden termination must stay off: they let macOS silently
	     exit the app (clean exit 0) whenever it looks idle or backgrounded,
	     which killed long unattended sessions (recording, audio-reactive
	     visuals behind other windows) and the unit-test host mid-run. Nothing
	     in the app manages the NSProcessInfo termination counters, so opting
	     in is unsafe with unsaved scene state. -->
	<key>NSUbiquitousContainers</key>
	<dict>
		<key>iCloud.com.puppypower.Threshold</key>
		<dict>
			<key>NSUbiquitousContainerIsDocumentScopePublic</key>
			<true/>
			<key>NSUbiquitousContainerName</key>
			<string>Threshold</string>
			<key>NSUbiquitousContainerSupportedFolderLevels</key>
			<string>Any</string>
		</dict>
	</dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.content</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Threshold Fractal Scene</string>
			<key>UTTypeIconFile</key>
			<string>ThresholdDocumentIcon.icns</string>
			<key>UTTypeIdentifier</key>
			<string>com.puppypower.threshold.scene</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<string>threshscene</string>
				<key>public.mime-type</key>
				<string>application/vnd.puppypower.threshold.scene+json</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.content</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Threshold Music Preset</string>
			<key>UTTypeIconFile</key>
			<string>ThresholdDocumentIcon.icns</string>
			<key>UTTypeIdentifier</key>
			<string>com.puppypower.threshold.music-preset</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<string>threshmp</string>
				<key>public.mime-type</key>
				<string>application/vnd.puppypower.threshold.music-preset+json</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.content</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Threshold Animation</string>
			<key>UTTypeIconFile</key>
			<string>ThresholdDocumentIcon.icns</string>
			<key>UTTypeIdentifier</key>
			<string>com.puppypower.threshold.animation</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<string>threshanim</string>
				<key>public.mime-type</key>
				<string>application/vnd.puppypower.threshold.animation+json</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.content</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Threshold Music Video Animation</string>
			<key>UTTypeIconFile</key>
			<string>ThresholdDocumentIcon.icns</string>
			<key>UTTypeIdentifier</key>
			<string>com.puppypower.threshold.music-animation</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<string>threshanimv</string>
				<key>public.mime-type</key>
				<string>application/vnd.puppypower.threshold.music-animation+json</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.content</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Threshold Custom Formula</string>
			<key>UTTypeIconFile</key>
			<string>ThresholdDocumentIcon.icns</string>
			<key>UTTypeIdentifier</key>
			<string>com.puppypower.threshold.formula</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<string>threshfx</string>
				<key>public.mime-type</key>
				<string>application/vnd.puppypower.threshold.formula+json</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
