  "embeddedFormula": {
    "schemaVersion": 1,
    "id": "com.puppypower.threshold.embedded.hyperbolictessellation",
    "name": "Hyperbolic Tessellation",
    "category": "Hyperbolic / Coxeter",
    "author": "Knighty (2012), ported by Threshold",
    "description": "3D hyperbolic honeycomb {m,3,n,3} in the Poincare ball model. Inverse stereographic projection into the Minkowski hyperboloid, Coxeter mirror folds, then distance to the nearest vertex/edge of the fundamental cell. Ported from knighty's Fragmentarium distance estimator. Try Type M / Type N and the U/V/W/T node weights.",
    "functionStem": "HyperbolicTessellation",
    "metalSource": "// === Hyperbolic Tessellation (3D) \u2014 knighty 2012 ===\n// Coxeter group cyclic m-3-n-3, Poincare ball model.\n// Ported from Fragmentarium (Knighty, 2012) to Threshold's embedded-formula\n// contract. The Fragmentarium globals computed in init() are recomputed per\n// DE call into a local HTess struct (Metal has no per-thread mutable globals).\n// NOTE: MSL has cosh/sinh but NOT radians/degrees \u2014 none are used here.\n\nstruct HTess {\n    float4 nc;\n    float4 nd;\n    float4 p;\n    float  pp;\n    float  cVR, sVR, cSR, sSR, cRA, sRA;\n    float3 rotv;\n    bool   uniformRadius;\n    float  VRadius, SRadius;\n};\n\n// Minkowski (Lorentz) dot product for the hyperboloid model.\nFORCE_INLINE float ht_hdot(float4 a, float4 b) {\n    return dot(a.xyz, b.xyz) - a.w * b.w;\n}\n\n// Normalize a timelike vector (w^2 - |xyz|^2 > 0).\nFORCE_INLINE float4 ht_normw(float4 v) {\n    float l = 1.0f / sqrt(max(v.w * v.w - dot(v.xyz, v.xyz), 1e-12f));\n    return v * l;\n}\n\n// Precompute the fundamental-domain mirrors (nc, nd), principal node p and the\n// hyperbolic cosh/sinh of the radii + boost. Mirrors Fragmentarium's init().\nFORCE_INLINE HTess ht_init(int TypeM, int TypeN,\n                           float U, float V, float W, float T,\n                           float VRadius, float SRadius,\n                           float RotAngle, float3 rotVector, bool uniformRadius) {\n    HTess h;\n    float cospim = cos(M_PI_F / float(TypeM));\n    float cospin = cos(M_PI_F / float(TypeN));\n    float scospim = sqrt(max(0.75f - cospim * cospim, 1e-12f));\n    float scospin = sqrt(max(cospin * cospin\n                         + (cospim + cospin) * (cospim + cospin) / (3.0f - 4.0f * cospim * cospim)\n                         - 0.75f, 1e-12f));\n    h.nc = float4(-cospim, -0.5f, scospim, 0.0f);\n    h.nd = float4(-0.5f, -cospin, -0.5f * (cospin + cospim) / scospim, -scospin);\n\n    float4 pabc = float4(0.0f, 0.0f, 0.0f, h.nc.z);\n    float4 pbdc = float4(-h.nc.z * h.nd.w, 0.0f, h.nc.x * h.nd.w, (-h.nc.z * h.nd.x + h.nc.x * h.nd.z));\n    float4 pcda = float4(0.0f, -h.nc.z * h.nd.w, h.nc.y * h.nd.w, (h.nc.y * h.nd.z - h.nc.z * h.nd.y));\n    float4 pdba = float4(0.0f, 0.0f, -h.nd.w, -h.nd.z);\n\n    h.p = U * pabc + V * pbdc + W * pcda + T * pdba;\n    h.pp = -ht_hdot(h.p, h.p);\n    if (h.pp > 1e-4f) { h.p = ht_normw(h.p); h.pp = 1.0f; }\n\n    h.cVR = cosh(VRadius); h.sVR = sinh(VRadius);\n    h.cSR = cosh(SRadius); h.sSR = sinh(SRadius);\n    h.cRA = cosh(RotAngle); h.sRA = -sinh(RotAngle);\n    h.rotv = normalize(rotVector);\n    h.uniformRadius = uniformRadius;\n    h.VRadius = VRadius; h.SRadius = SRadius;\n    return h;\n}\n\n// Map the 16 formula params -> init(). Layout:\n//  [0]TypeM [1]TypeN [2]U [3]V [4]W [5]T [6]VRadius [7]SRadius\n//  [8]uniformRadius [9]RotAngle [10]CutSphere [11..13]RotVector\nFORCE_INLINE HTess ht_paramsToInit(FormulaParams fp) {\n    int TypeM = clamp(int(round(fp.params[0])), 4, 5);\n    int TypeN = clamp(int(round(fp.params[1])), 3, 6);\n    float U = fp.params[2], V = fp.params[3], W = fp.params[4], T = fp.params[5];\n    float VRadius = max(fp.params[6], 0.0f);\n    float SRadius = max(fp.params[7], 0.0f);\n    bool uniformR = fp.params[8] > 0.5f;\n    float RotAngle = fp.params[9];\n    float3 rotVec = float3(fp.params[11], fp.params[12], fp.params[13]);\n    if (dot(rotVec, rotVec) < 1e-8f) rotVec = float3(0.0f, 0.0f, 1.0f);\n    return ht_init(TypeM, TypeN, U, V, W, T, VRadius, SRadius, RotAngle, rotVec, uniformR);\n}\n\n// Hyperbolic boost on the plane (rotv, w-axis) \u2014 equivalent to a translation\n// inside hyperbolic space.\nFORCE_INLINE float4 ht_rotate(float4 p, HTess h) {\n    float vp = dot(h.rotv, p.xyz);\n    float4 p1 = p;\n    p1.xyz += h.rotv * (vp * (h.cRA - 1.0f) + p.w * h.sRA);\n    p1.w   += vp * h.sRA + p.w * (h.cRA - 1.0f);\n    return p1;\n}\n\n// Reflect into the fundamental domain (Minkowski-space mirror folds).\nFORCE_INLINE float4 ht_fold(float4 pos, HTess h, int iterations) {\n    int loop = clamp(iterations, 0, 40);\n    for (int i = 0; i < loop; ++i) {\n        pos.xy = abs(pos.xy);\n        float t = -2.0f * min(0.0f, ht_hdot(pos, h.nc)); pos += t * h.nc;\n        t = -2.0f * min(0.0f, ht_hdot(pos, h.nd)); pos += t * h.nd;\n    }\n    return pos;\n}\n\n// Convert a hyperbolic distance (given as cosh ca / sinh sa) to a distance in\n// the flat projection space at projected radius r.\nFORCE_INLINE float ht_DD(float ca, float sa, float r) {\n    float r2 = r * r;\n    return (2.0f * r * ca + (1.0f + r2) * sa)\n         / ((1.0f + r2) * ca + 2.0f * r * sa + 1.0f - r2) - r;\n}\n\nFORCE_INLINE float ht_dist2Vertex(float4 z, float r, HTess h) {\n    float ca = -ht_hdot(z, h.p);\n    float sa = 0.5f * sqrt(max(-ht_hdot(h.p - z, h.p - z) * ht_hdot(h.p + z, h.p + z), 0.0f));\n    if (h.uniformRadius) return ht_DD(ca, sa, r) - h.VRadius;\n    return ht_DD(ca * h.cVR - sa * h.sVR, sa * h.cVR - ca * h.sVR, r);\n}\n\nFORCE_INLINE float ht_dist2Segment(float4 z, float4 n, float r, HTess h) {\n    float zn = ht_hdot(z, n), zp = ht_hdot(z, h.p), np = ht_hdot(n, h.p);\n    float denom = h.pp + np * np;\n    if (abs(denom) < 1e-9f) denom = 1e-9f;\n    float det = 1.0f / denom;\n    float alpha = det * (zn * np - zp);\n    float beta  = det * (np * zp + zn * h.pp);\n    float4 pmin = ht_normw(alpha * h.p + min(0.0f, beta) * n);\n    float ca = -ht_hdot(z, pmin);\n    float sa = 0.5f * sqrt(max(-ht_hdot(pmin - z, pmin - z) * ht_hdot(pmin + z, pmin + z), 0.0f));\n    if (h.uniformRadius) return ht_DD(ca, sa, r) - h.SRadius;\n    return ht_DD(ca * h.cSR - sa * h.sSR, sa * h.cSR - ca * h.sSR, r);\n}\n\nFORCE_INLINE float ht_dist2Segments(float4 z, float r, HTess h) {\n    float da = ht_dist2Segment(z, float4(1.0f, 0.0f, 0.0f, 0.0f), r, h);\n    float db = ht_dist2Segment(z, float4(0.0f, 1.0f, 0.0f, 0.0f), r, h);\n    float dc = ht_dist2Segment(z, h.nc, r, h);\n    float dd = ht_dist2Segment(z, h.nd, r, h);\n    return min(min(da, db), min(dc, dd));\n}\n\nFORCE_INLINE float DE_HyperbolicTessellation(float3 pos, FormulaParams fp, float3x3 rot,\n                                             int iterations, int colorIterations,\n                                             thread OrbitData& orbit) {\n    float CSphRad = clamp(fp.params[10], 0.1f, 0.999f);\n    float r = length(pos);\n    // Outside the Poincare ball: stop at the cutting sphere. This also avoids\n    // the 1/(1-r^2) blow-up of the inverse stereographic projection at r->1.\n    if (r >= CSphRad) {\n        orbit.trap = r * r;\n        orbit.trapIteration = 0;\n        orbit.trapPosition = pos;\n        orbit.finalP = pos;\n        orbit.iterationsUsed = 0;\n        return r - CSphRad;\n    }\n    HTess h = ht_paramsToInit(fp);\n    bool hasRotation = hasRot1Precomputed(fp);\n    float3 sp = hasRotation ? (rot * pos) : pos; // rotation preserves length r\n\n    float4 z4 = float4(2.0f * sp, 1.0f + r * r) * (1.0f / (1.0f - r * r));\n    z4 = ht_rotate(z4, h);\n    z4 = ht_fold(z4, h, iterations);\n\n    orbit.trap = dot(z4.xyz, z4.xyz);\n    orbit.trapIteration = min(max(colorIterations, 0), iterations);\n    orbit.trapPosition = z4.xyz;\n    orbit.finalP = z4.xyz;\n    orbit.iterationsUsed = clamp(iterations, 0, 40);\n\n    float d;\n    if (h.pp == 1.0f) d = min(ht_dist2Vertex(z4, r, h), ht_dist2Segments(z4, r, h));\n    else              d = ht_dist2Segments(z4, r, h);\n    return max(r - CSphRad, d);\n}\n\nFORCE_INLINE float DE_HyperbolicTessellation_Dist(float3 pos, FormulaParams fp, float3x3 rot, int iterations) {\n    float CSphRad = clamp(fp.params[10], 0.1f, 0.999f);\n    float r = length(pos);\n    if (r >= CSphRad) return r - CSphRad;\n    HTess h = ht_paramsToInit(fp);\n    bool hasRotation = hasRot1Precomputed(fp);\n    float3 sp = hasRotation ? (rot * pos) : pos;\n    float4 z4 = float4(2.0f * sp, 1.0f + r * r) * (1.0f / (1.0f - r * r));\n    z4 = ht_rotate(z4, h);\n    z4 = ht_fold(z4, h, iterations);\n    float d;\n    if (h.pp == 1.0f) d = min(ht_dist2Vertex(z4, r, h), ht_dist2Segments(z4, r, h));\n    else              d = ht_dist2Segments(z4, r, h);\n    return max(r - CSphRad, d);\n}\n",
