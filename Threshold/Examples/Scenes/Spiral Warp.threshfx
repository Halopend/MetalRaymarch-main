{
  "version" : 1,
  "formula" : {
    "schemaVersion" : 1,
    "kind" : "spaceWarp",
    "id" : "sample.spiralZ",
    "name" : "Spiral Warp",
    "category" : "Space Warp",
    "author" : "Threshold samples",
    "description" : "A radial spiral about the depth axis: rotation angle grows with distance from the Z axis, swirling any fractal into a vortex. Strength controls the swirl; 0 = off.",
    "functionStem" : "spiralZ",
    "metalSource" : "FORCE_INLINE float3 customSpaceWarp(float3 p, float strength, float param1, float param2, float param3) {\n    if (strength <= 0.0f) { return p; }\n    float angle = strength * length(p.xy) * 2.0f;\n    float c = cos(angle);\n    float s = sin(angle);\n    return float3(c * p.x - s * p.y, s * p.x + c * p.y, p.z);\n}\nFORCE_INLINE float customSpaceWarpDEScale(float3 p, float strength, float param1, float param2, float param3) {\n    return 1.0f;\n}\n",
    "params" : []
  }
}
