  "embeddedFormula": {
    "author": "Knighty (Fragmentarium), ported by Threshold",
    "category": "Kleinian",
    "defaultColorIterations": 5,
    "defaultIterations": 5,
    "description": "Theli-at's Pseudo Kleinian (Knighty): a scale-1 Julia box (cubic clamp-fold + inversion with constant offset C) whose final DE is the folded plane abs(p.z - Offset.z), scaled by the accumulated fold factor. Produces dense Kleinian-limit-set architecture with corridors and forests. Loop runs up to the main iteration count but breaks early once the fold converges (p stops changing).",
    "functionStem": "PseudoKleinian",
    "id": "com.puppypower.threshold.embedded.pseudokleinian",
    "metalSource": "// ===== Pseudo Kleinian (Theli-at / Knighty), scale-1 Julia box =====\n// Source: PseudoKleinian.frag / 07-Shape1-PK.frag Thing2. Loop bounded by main\n// iterations with an early convergence break (ap != p in the source -> epsilon\n// break here).\n// Params: 0 Size, 1..3 CSize.xyz, 4..6 C.xyz, 7 DEoffset, 8..10 Offset.xyz.\n// TThickness baked away (only used by the commented \"Thingy\" path).\n// Iterations = source MI. ColorIterations limits orbit-trap iterations.\n\nFORCE_INLINE float DE_PseudoKleinian(float3 pos, FormulaParams fp, float3x3 rot,\n                                     int iterations, int colorIterations,\n                                     thread OrbitData& orbit) {\n    float  Size    = fp.params[0];\n    float3 CSize   = float3(fp.params[1], fp.params[2], fp.params[3]);\n    float3 C       = float3(fp.params[4], fp.params[5], fp.params[6]);\n    float  DEoffset= fp.params[7];\n    float3 Offset  = float3(fp.params[8], fp.params[9], fp.params[10]);\n\n    bool hasRotation = hasRot1Precomputed(fp);\n    float3 p = hasRotation ? rot * pos : pos;\n\n    float DEfactor = 1.0f;\n\n    float trap = 1e20f; int trapIter = 0; float3 trapPos = p;\n    int trapIterations = min(max(colorIterations, 0), iterations);\n\n    int n = clamp(iterations, 0, 64);\n    int i = 0;\n    float3 ap = p + 1.0f; // force first iteration (mirrors ap=p+1)\n    for (; i < n; ++i) {\n        // convergence break: stop once p stopped changing (source: ap != p)\n        if (all(abs(ap - p) < 1e-7f)) break;\n        ap = p;\n\n        // cubic clamp fold\n        p = 2.0f * clamp(p, -CSize, CSize) - p;\n\n        float r2 = dot(p, p);\n\n        // orbit trap on abs(float4(p, r2))\n        if (i < trapIterations) {\n            UpdateTrapMinR2(trap, trapIter, trapPos, r2, i, trapIterations, p);\n        }\n\n        // inversion-ish scale: k = max(Size / r2, 1)\n        float k = max(Size / max(r2, 1e-12f), 1.0f);\n        p *= k;\n        DEfactor *= k;\n\n        p += C;\n\n        // second orbit trap on abs(float4(p, dot(p,p)))\n        if (i < trapIterations) {\n            float r2b = dot(p, p);\n            UpdateTrapMinR2(trap, trapIter, trapPos, r2b, i, trapIterations, p);\n        }\n    }\n\n    orbit.trap          = trap;\n    orbit.trapIteration = trapIter;\n    orbit.trapPosition  = trapPos;\n    orbit.finalP        = p;\n    orbit.iterationsUsed= i;\n\n    // plane DE folded back through the accumulated scale\n    return abs(0.5f * abs(p.z - Offset.z) / max(DEfactor, 1e-12f) - DEoffset);\n}\n\nFORCE_INLINE float DE_PseudoKleinian_Dist(float3 pos, FormulaParams fp, float3x3 rot, int iterations) {\n    float  Size    = fp.params[0];\n    float3 CSize   = float3(fp.params[1], fp.params[2], fp.params[3]);\n    float3 C       = float3(fp.params[4], fp.params[5], fp.params[6]);\n    float  DEoffset= fp.params[7];\n    float3 Offset  = float3(fp.params[8], fp.params[9], fp.params[10]);\n\n    bool hasRotation = hasRot1Precomputed(fp);\n    float3 p = hasRotation ? rot * pos : pos;\n\n    float DEfactor = 1.0f;\n\n    int n = clamp(iterations, 0, 64);\n    int i = 0;\n    float3 ap = p + 1.0f;\n    for (; i < n; ++i) {\n        if (all(abs(ap - p) < 1e-7f)) break;\n        ap = p;\n\n        p = 2.0f * clamp(p, -CSize, CSize) - p;\n\n        float r2 = dot(p, p);\n        float k = max(Size / max(r2, 1e-12f), 1.0f);\n        p *= k;\n        DEfactor *= k;\n\n        p += C;\n    }\n\n    return abs(0.5f * abs(p.z - Offset.z) / max(DEfactor, 1e-12f) - DEoffset);\n}",
    "name": "Pseudo Kleinian",
