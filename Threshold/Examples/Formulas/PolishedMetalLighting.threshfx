{
  "formula": {
    "author": "Threshold external-lighting example",
    "category": "Lighting",
    "description": "A polished-metal material built entirely as an external lighting effect. It converts Threshold's host colour into steel, gold, or copper; maps roughness to a normalized highlight lobe; suppresses diffuse response as metalness rises; and adds a small procedural environment reflection so full metals remain legible between direct highlights.",
    "functionStem": "PolishedMetalLighting",
    "id": "com.puppypower.threshold.example.polishedMetalLighting",
    "kind": "lighting",
    "metalSource": "// Polished Metal — an external-author material with no host-code changes\n// @param 0 \"Metalness\" default=0.95 min=0 max=1 step=0.01\n// @param 1 \"Roughness\" default=0.18 min=0.0625 max=1 step=0.01\n// @param 2 \"Tint Strength\" default=0.85 min=0 max=1 step=0.01\n// @param 3 \"Metal Warmth\" default=0.15 min=0 max=1 step=0.01\n// @param 4 \"Direct Highlights\" default=1.2 min=0 max=2 step=0.01\n// @param 5 \"Environment Reflection\" default=0.85 min=0 max=3 step=0.01\n// @param 6 \"Environment Contrast\" default=1.2 min=0.25 max=3 step=0.01\n// @param 7 \"Edge Reflection\" default=1 min=0 max=2 step=0.01\n// @param 8 \"Environment Spin\" default=0.08 min=-2 max=2 step=0.01\n// @param 9 \"Animate Environment\" default=1 min=0 max=1 step=1 bool\n// @param 10 \"Artistic Fill\" default=0.06 min=0 max=1 step=0.01\nFORCE_INLINE ThresholdMaterial Lighting_PolishedMetalLighting(\n    ThresholdLightingContext context,\n    ThresholdMaterial material)\n{\n    float metalness = saturate(thresholdLightingParam(context, 0u));\n    float roughness = clamp(thresholdLightingParam(context, 1u), 0.0625f, 1.0f);\n    float tintStrength = saturate(thresholdLightingParam(context, 2u));\n    float warmth = saturate(thresholdLightingParam(context, 3u));\n    float directStrength = max(thresholdLightingParam(context, 4u), 0.0f);\n    float environmentStrength = max(thresholdLightingParam(context, 5u), 0.0f);\n    float environmentContrast = max(thresholdLightingParam(context, 6u), 0.01f);\n    float edgeStrength = max(thresholdLightingParam(context, 7u), 0.0f);\n    float spin = thresholdLightingParam(context, 8u);\n    float animateEnvironment = thresholdLightingParam(context, 9u);\n    float artisticFill = saturate(thresholdLightingParam(context, 10u));\n\n    float3 hostAlbedo = clamp(float3(material.baseColor), 0.0f, 1.0f);\n    float3 steel = float3(0.56f, 0.66f, 0.78f);\n    float3 gold = float3(1.00f, 0.58f, 0.16f);\n    float3 copper = float3(0.96f, 0.32f, 0.12f);\n    float3 warmMetal = mix(gold, copper, saturate(warmth * 2.0f - 1.0f));\n    float3 paletteMetal = mix(steel, warmMetal, saturate(warmth * 2.0f));\n    float3 albedo = mix(hostAlbedo, paletteMetal, tintStrength);\n\n    // Conductor Fresnel, compensated for Threshold's host-owned dielectric term.\n    float NoV = saturate(dot(context.normal, context.viewDirection));\n    float edge = powr(max(1.0f - NoV, 0.0f), 5.0f);\n    float hostFresnel = 0.04f + 0.96f * edge;\n    float3 F0 = mix(float3(0.04f), albedo, metalness);\n    float3 targetFresnel = clamp(\n        F0 + (1.0f - F0) * edge * edgeStrength,\n        float3(0.0f), float3(1.0f));\n\n    // Roughness-to-Blinn mapping with approximate energy normalization.\n    float exponent = clamp(2.0f / max(roughness * roughness, 1e-6f) - 2.0f,\n                           1.0f, 512.0f);\n    float diffuseWeight = (1.0f - metalness)\n        * (1.0f - max(targetFresnel.x, max(targetFresnel.y, targetFresnel.z)));\n    float normalizedSpecular = (exponent + 8.0f) / (16.0f * 3.14159265f);\n\n    material.baseColor = half3(albedo);\n    material.diffuseScale = diffuseWeight + artisticFill * metalness * 0.18f;\n    material.ambientScale = diffuseWeight + artisticFill * metalness * 0.32f;\n    material.specularTint = half3(targetFresnel / max(hostFresnel, 1e-4f));\n    material.specularPower = exponent;\n    material.specularScale = normalizedSpecular * directStrength;\n\n    // Tiny analytic studio environment: cool sky, dark floor, and two softboxes.\n    // This is specular IBL intent expressed through emission, so Threshold still\n    // owns shadows, fog, glow, exposure, and post-processing after the material.\n    float3 reflected = reflect(-context.viewDirection, context.normal);\n    float angle = context.animationTime * spin * animateEnvironment;\n    float cs = cos(angle);\n    float sn = sin(angle);\n    reflected.xz = float2(\n        reflected.x * cs - reflected.z * sn,\n        reflected.x * sn + reflected.z * cs);\n\n    float skyAmount = smoothstep(-0.35f, 0.55f, reflected.y);\n    float3 environment = mix(float3(0.018f, 0.012f, 0.010f),\n                             float3(0.16f, 0.29f, 0.52f), skyAmount);\n    float horizon = powr(max(1.0f - abs(reflected.y), 0.0f),\n                         mix(3.0f, 18.0f, 1.0f - roughness));\n    float softboxA = powr(max(dot(reflected, normalize(float3(0.72f, 0.38f, 0.58f))), 0.0f),\n                          mix(6.0f, 96.0f, 1.0f - roughness));\n    float softboxB = powr(max(dot(reflected, normalize(float3(-0.62f, 0.12f, 0.78f))), 0.0f),\n                          mix(4.0f, 48.0f, 1.0f - roughness));\n    environment += horizon * float3(0.28f, 0.34f, 0.42f);\n    environment += softboxA * float3(2.4f, 2.1f, 1.6f);\n    environment += softboxB * float3(0.45f, 0.85f, 1.55f);\n\n    float3 averageEnvironment = float3(0.13f, 0.16f, 0.21f);\n    environment = mix(environment, averageEnvironment, roughness * roughness);\n    environment = powr(max(environment, float3(0.0f)),\n                       float3(1.0f / environmentContrast));\n    material.emission += half3(environment * targetFresnel * environmentStrength);\n    return material;\n}\n",
    "name": "Polished Metal Lighting",
    "params": [
      { "default": 0.95, "index": 0, "max": 1.0, "min": 0.0, "name": "Metalness", "step": 0.01 },
      { "default": 0.18, "index": 1, "max": 1.0, "min": 0.0625, "name": "Roughness", "step": 0.01 },
      { "default": 0.85, "index": 2, "max": 1.0, "min": 0.0, "name": "Tint Strength", "step": 0.01 },
      { "default": 0.15, "index": 3, "max": 1.0, "min": 0.0, "name": "Metal Warmth", "step": 0.01 },
      { "default": 1.2, "index": 4, "max": 2.0, "min": 0.0, "name": "Direct Highlights", "step": 0.01 },
      { "default": 0.85, "index": 5, "max": 3.0, "min": 0.0, "name": "Environment Reflection", "step": 0.01 },
      { "default": 1.2, "index": 6, "max": 3.0, "min": 0.25, "name": "Environment Contrast", "step": 0.01 },
      { "default": 1.0, "index": 7, "max": 2.0, "min": 0.0, "name": "Edge Reflection", "step": 0.01 },
      { "default": 0.08, "index": 8, "max": 2.0, "min": -2.0, "name": "Environment Spin", "step": 0.01 },
      { "default": 1.0, "index": 9, "isBool": true, "max": 1.0, "min": 0.0, "name": "Animate Environment", "step": 1.0 },
      { "default": 0.06, "index": 10, "max": 1.0, "min": 0.0, "name": "Artistic Fill", "step": 0.01 }
    ],
    "schemaVersion": 1,
    "supportedEffectTags": [
      "lighting",
      "color"
    ]
  },
  "version": 1
}
