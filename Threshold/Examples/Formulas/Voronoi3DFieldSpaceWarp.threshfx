{
  "formula": {
    "author": "Threshold external-space-warp example",
    "category": "Space Effects",
    "description": "Portable external-ABI version of Threshold's 3-D Voronoi distortion field. It seeds the nearest two sites from a 3x3x3 neighbourhood, then checks only AABB-qualified cells in the outer 5x5x5 shell. The F2-F1 fade makes the displacement continuous at cell boundaries, and the companion 1 + 7*strength DE divisor is conservative. The current external space-warp ABI supplies strength plus three generic scalars, so this example uses param1/param2/param3 as XYZ phase offsets and fixes cell density to 1.5 and jitter to 1.0.",
    "functionStem": "Voronoi3DFieldSpaceWarp",
    "id": "com.puppypower.threshold.example.voronoi3DFieldSpaceWarp",
    "kind": "spaceWarp",
    "metalSource": "// Exact adaptive 3-D Voronoi domain distortion for the external space-warp ABI.\n// strength is the displacement amount; param1/2/3 are XYZ phase offsets.\n// Density and jitter are fixed because this ABI has no additional live parameter bank.\nFORCE_INLINE float3 thresholdExampleVoronoiHash(float3 coordinate) {\n    float3 hash = fract(coordinate * float3(0.1031f, 0.1030f, 0.0973f));\n    hash += dot(hash, hash.yxz + 33.33f);\n    return fract((hash.xxy + hash.yxx) * hash.zyx);\n}\n\nFORCE_INLINE float3 customSpaceWarp(float3 p, float strength,\n                                    float param1, float param2, float param3) {\n    if (strength <= 0.0f) { return p; }\n\n    const float density = 1.5f;\n    const float jitter = 1.0f;\n    float3 offset = float3(param1, param2, param3);\n    float3 q = p * density + offset;\n    float3 cell = floor(q);\n    float3 local = fract(q);\n    float nearest = 1.0e10f;\n    float secondNearest = 1.0e10f;\n    float3 nearestDelta = float3(0.0f);\n\n    // Seed F1 and F2 with the always-near 3x3x3 neighbourhood.\n    for (int z = -1; z <= 1; ++z) {\n        for (int y = -1; y <= 1; ++y) {\n            for (int x = -1; x <= 1; ++x) {\n                float3 neighbour = float3(x, y, z);\n                float3 hash = thresholdExampleVoronoiHash(cell + neighbour);\n                float3 site = neighbour + mix(float3(0.5f), hash, jitter);\n                float3 delta = site - local;\n                float distanceSquared = dot(delta, delta);\n                if (distanceSquared < nearest) {\n                    secondNearest = nearest;\n                    nearest = distanceSquared;\n                    nearestDelta = delta;\n                } else if (distanceSquared < secondNearest) {\n                    secondNearest = distanceSquared;\n                }\n            }\n        }\n    }\n\n    // A 3x3x3 search can miss F2 near a base-cell face. Every site outside the\n    // 5x5x5 envelope is farther than the two guaranteed nearby cells, so the\n    // envelope is exact. Its remaining cells are hashed only when their allowed\n    // site AABB can beat the current F2.\n    float siteMargin = 0.5f * (1.0f - jitter);\n    float nearestFace = min(min(local.x, 1.0f - local.x),\n                            min(local.y, min(1.0f - local.y,\n                                             min(local.z, 1.0f - local.z))));\n    float outerLowerBound = 1.0f + siteMargin + nearestFace;\n    if (outerLowerBound * outerLowerBound <= secondNearest + 1.0e-6f) {\n        for (int z = -2; z <= 2; ++z) {\n            for (int y = -2; y <= 2; ++y) {\n                for (int x = -2; x <= 2; ++x) {\n                    if (x >= -1 && x <= 1\n                        && y >= -1 && y <= 1\n                        && z >= -1 && z <= 1) { continue; }\n\n                    float3 neighbour = float3(x, y, z);\n                    float3 cellMin = neighbour + siteMargin;\n                    float3 cellMax = neighbour + (1.0f - siteMargin);\n                    float3 toCell = max(max(cellMin - local, local - cellMax), 0.0f);\n                    if (dot(toCell, toCell) > secondNearest + 1.0e-6f) { continue; }\n\n                    float3 hash = thresholdExampleVoronoiHash(cell + neighbour);\n                    float3 site = neighbour + mix(float3(0.5f), hash, jitter);\n                    float3 delta = site - local;\n                    float distanceSquared = dot(delta, delta);\n                    if (distanceSquared < nearest) {\n                        secondNearest = nearest;\n                        nearest = distanceSquared;\n                        nearestDelta = delta;\n                    } else if (distanceSquared < secondNearest) {\n                        secondNearest = distanceSquared;\n                    }\n                }\n            }\n        }\n    }\n\n    float gap = max(sqrt(secondNearest) - sqrt(nearest), 0.0f);\n    float interior = smoothstep(0.0f, 1.0f, gap);\n    return p + nearestDelta * (strength * interior / density);\n}\n\nFORCE_INLINE float customSpaceWarpDEScale(float3 p, float strength,\n                                          float param1, float param2, float param3) {\n    (void)p;\n    (void)param1;\n    (void)param2;\n    (void)param3;\n    // F1 and F2 are 1-Lipschitz. With max smoothstep slope 1.5 and\n    // nearest-site distance at most sqrt(3), 1 + 7*strength is conservative.\n    return strength > 0.0f ? 1.0f + 7.0f * strength : 1.0f;\n}\n",
    "name": "3D Voronoi Field (Space Warp)",
    "params": [],
    "schemaVersion": 1
  },
  "version": 1
}
